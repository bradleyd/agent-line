{
  "name": "rust-nvim",
  "image": "mcr.microsoft.com/devcontainers/rust:latest",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-nvim.sh",
  "containerEnv": {
    "EDITOR": "nvim"
  }
}
